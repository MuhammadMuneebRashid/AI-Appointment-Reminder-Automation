    {
      "parameters": {
        "jsCode": "const currentTime = new Date();\n\nreturn items.filter(item => {\n  const [day, month, year] = item.json.appointment_date.split('-').map(Number);\n  const [hour, minute] = item.json.appointment_time.split(':').map(Number);\n\n  const appointmentTime = Date.UTC(\n    year,\n    month - 1,\n    day,\n    hour - 5,\n    minute\n  );\n\n  const hoursLeft =\n    (appointmentTime - currentTime.getTime()) / 3600000;\n\n  return hoursLeft >= 23.5 && hoursLeft <= 24.5;\n});\n "
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
