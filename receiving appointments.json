      "parameters": {
        "jsCode": "const fields=$input.first().json.body.data.fields\nconst f1=fields.find(f=>f.label===\"Full Name:\")\nconst name=f1.value;\nconst f2=fields.find(f=>f.label===\"Email:\")\nconst email=f2.value;\nconst f3=fields.find(f=>f.label===\"Phone :\")\nconst phone=f3.value;\nconst f4=fields.find(f=>f.label===\"Appointment Date:\")\nconst appointment_date=f4.value;\nconst f5=fields.find(f=>f.label===\"Appointment time:\")\nconst appointment_time=f5.value;\nconst f6=fields.find(f=>f.label===\"Duration:\")\nconst duration=f6.value;\nconst f7=fields.find(f=>f.label=== \"Service\")\nconst value=f7.value[0];\nconst options=f7.options.find(f=>f.id===value)\nconst service=options.text;\nreturn[{\n  name,\n  email,\n  phone,\n  appointment_date,\n  appointment_time,\n  duration,\n  service\n}];"
      },
